{
  "name": "events-mining-framework",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Deterministic per-source event extraction, durable local dispatch and repair evidence",
  "scripts": {
    "recon": "node scripts/recon.mjs",
    "mine": "node scripts/mine.mjs",
    "status": "node scripts/status.mjs",
    "assess": "node scripts/build-assessment.mjs",
    "samples": "node scripts/export-samples.mjs",
    "test": "node --test tests/*.test.mjs",
    "framework": "node scripts/framework.mjs",
    "registry:build": "node scripts/build-registry.mjs",
    "start": "node src/server.mjs",
    "railway:check": "tsc -p .railway/tsconfig.json",
    "railway:plan": "railway config plan --file .railway/railway.ts",
    "railway:apply": "railway config apply --file .railway/railway.ts",
    "hosting:verify": "node scripts/verify-hosting.mjs",
    "db:check": "node scripts/check-database.mjs --local"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "playwright": "1.64.1"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "prettier": "3.6.2",
    "railway": "3.15.0",
    "typescript": "5.9.3"
  }
}
